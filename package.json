{
  "name": "cygnus_core",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": ".fvm/flutter_sdk/bin/flutter pub run build_runner build --delete-conflicting-outputs",
    "build:windows": ".fvm\\flutter_sdk\\bin\\flutter.bat pub run build_runner build --delete-conflicting-outputs",
    "watch": ".fvm/flutter_sdk/bin/flutter pub run build_runner watch --delete-conflicting-outputs",
    "watch:windows": ".fvm\\flutter_sdk\\bin\\flutter.bat pub run build_runner watch --delete-conflicting-outputs",

    "format": ".fvm/flutter_sdk/bin/dart format lib example/integration_test",
    "format:windows": ".fvm\\flutter_sdk\\bin\\dart.bat format lib example/integration_test",

    "docs:gen": ".fvm/flutter_sdk/bin/dart doc --output=doc/api .",
    "docs:gen:windows": ".fvm\\flutter_sdk\\bin\\dart.bat doc --output=doc/api .",
    "docs:serve": ".fvm/flutter_sdk/bin/flutter pub global activate dhttpd && .fvm/flutter_sdk/bin/flutter pub global run dhttpd:dhttpd --path doc/api",
    "docs:serve:windows": ".fvm\\flutter_sdk\\bin\\flutter.bat pub global activate dhttpd && .fvm\\flutter_sdk\\bin\\flutter.bat pub global run dhttpd:dhttpd --path doc/api",

    "publish:dry": ".fvm/flutter_sdk/bin/flutter pub publish --dry-run",
    "publish:dry:windows": ".fvm\\flutter_sdk\\bin\\flutter.bat pub publish --dry-run",
    "publish": ".fvm/flutter_sdk/bin/flutter pub publish",
    "publish:windows": ".fvm\\flutter_sdk\\bin\\flutter.bat pub publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KNightING/cygnus_core.git"
  },
  "author": "Lorenzo Pichilli",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KNightING/cygnus_core/issues"
  },
  "homepage": "https://github.com/KNightING/cygnus_core#README.md"
}
